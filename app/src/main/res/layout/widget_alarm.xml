<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-compatible layout: only LinearLayout, TextView, ImageView etc. NO ConstraintLayout -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Widget title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <!-- Alarm Row 1 -->
    <LinearLayout
        android:id="@+id/widgetRow1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_bg"
        android:layout_marginVertical="2dp"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetTime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="8:00 AM" />

            <TextView
                android:id="@+id/widgetLabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:text="Alarm" />

        </LinearLayout>

        <TextView
            android:id="@+id/widgetStatus1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="ON"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/widget_status_bg" />

    </LinearLayout>

    <!-- Alarm Row 2 -->
